{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run convertpdf.py",
            "type": "process",
            "command": "${config:python.defaultInterpreterPath}",
            "args": [
                "${workspaceFolder}/deliverables/convertpdf.py"
            ],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Run mergebib.py",
            "type": "process",
            "command": "${config:python.defaultInterpreterPath}",
            "args": [
                "${workspaceFolder}/deliverables/mergebib.py"
            ],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Prepare LaTeX",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Run convertpdf.py",
                "Run mergebib.py"
            ],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Compile LaTeX",
            "type": "shell",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-interaction=nonstopmode",
                "-synctex=1",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": {
                "owner": "latex",
                "fileLocation": ["relative", "${fileDirname}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                }
            }
        },
        {
            "label": "Prepare and Compile LaTeX",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Prepare LaTeX",
                "Compile LaTeX"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}